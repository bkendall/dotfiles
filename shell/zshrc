# ============================================================================
# Oh My Zsh Configuration
# ============================================================================
ZSH=$HOME/.oh-my-zsh
ZSH_THEME="" # Disabled to allow Starship / native Zsh vcs_info prompt
DISABLE_UPDATE_PROMPT=true

# ============================================================================
# Prompt Configuration (Starship with Zsh vcs_info fallback)
# ============================================================================
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
else
  autoload -Uz vcs_info
  precmd() { vcs_info }

  zstyle ':vcs_info:*' enable git
  zstyle ':vcs_info:git:*' check-for-changes true
  zstyle ':vcs_info:git:*' stagedstr '%F{green}+%f'
  zstyle ':vcs_info:git:*' unstagedstr '%F{red}?%f'
  zstyle ':vcs_info:git:*' formats '%F{cyan}|(%b%u%c)%f'
  zstyle ':vcs_info:git:*' actionformats '%F{cyan}|(%b|%a%u%c)%f'

  function _jobs_prompt() {
    local njobs
    njobs=$(jobs | wc -l | awk '{print $1}')
    if [ "$njobs" -ne 0 ]; then
      echo " %F{magenta}§%f"
    fi
  }

  PROMPT='%F{green}%m%f:%F{magenta}%c%f${vcs_info_msg_0_}$(_jobs_prompt) %(?.%F{green}.%F{red})%(!.#.»)%f '
  PROMPT2='%F{red}> %f'
fi

# ============================================================================
# Environment Variables
# ============================================================================
export EDITOR='vim'
export MYVIMRC=${DOTFILES:-$HOME/dotfiles}/vim/vimrc
export NVM_LAZY_LOAD=true

# ============================================================================
# Persistent Zsh History
# ============================================================================
HISTFILE=$HOME/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

setopt SHARE_HISTORY          # Share history across all active terminal sessions
setopt HIST_EXPIRE_DUPS_FIRST # Expire duplicate entries first when trimming history
setopt HIST_IGNORE_DUPS       # Don't record duplicate entry if same as previous
setopt HIST_IGNORE_ALL_DUPS   # Delete old duplicate entry if new entry is typed
setopt HIST_IGNORE_SPACE      # Don't record commands starting with a space
setopt HIST_SAVE_NO_DUPS      # Don't write duplicate entries to history file
setopt HIST_REDUCE_BLANKS     # Remove unnecessary blanks from commands

# ============================================================================
# PATH & Tool Configuration
# ============================================================================

# Go Configuration
if [ -d '/usr/local/go/bin' ]; then
  export PATH=$PATH:/usr/local/go/bin
fi
if [ -d '/opt/homebrew/opt/go/libexec/bin' ]; then
  export PATH=$PATH:/opt/homebrew/opt/go/libexec/bin
fi
if [ -d "$HOME/go/bin" ]; then
  export PATH=$PATH:$HOME/go/bin
fi

# Stitch dynamic SSH configurations if ~/.ssh/config.d/ exists
if [ -d "$HOME/.ssh/config.d" ]; then
  rm -f "$HOME/.ssh/config"
  cat "$HOME/.ssh/config.d"/*.config >> "$HOME/.ssh/config" 2>/dev/null || true
fi

# ============================================================================
# Oh My Zsh Plugins
# ============================================================================
plugins=(git brew docker zsh-nvm npm)

